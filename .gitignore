# Build output
*.eap
*.eap.old
*.o
*.a
*.so
*.exe

# ACAP build intermediates
app/package.conf*
app/param.conf
app/*_LICENSE.txt
app/manifest.json.bak
app/build/
app/.acap-build/
# Staged from repo root by `make stage-license` so acap-build can find it.
app/LICENSE

# Host test build output
app/test/host/build/
app/test/host/*.bin

# Editor / OS detritus
.DS_Store
.idea/
.vscode/
*.swp
*~
*.bak

# Coverage / profiling
*.gcda
*.gcno
*.gcov
coverage/

# Local secrets — never commit (test camera creds live in Claude memory)
.env
.env.*
!.env.example

# Claude Code local-only settings (project-level settings.json is committed)
.claude/settings.local.json
# Claude Code worktrees + transient agent briefs (never commit)
.claude/worktrees/
.claude/m8-briefs/

# Docker
.dockerignore.bak

# Soak harness writes here; durable evidence is committed under
# docs/verification/soak/ instead. This dir holds working state
# for in-flight runs only. Anchored to repo root so the
# committed docs/verification/soak/ is unaffected.
/soak/
